    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH params AS (\n  SELECT\n    NULLIF($1,'')::date AS date_from,\n    NULLIF($2,'')::date AS date_to,\n    GREATEST(COALESCE(NULLIF($3,'')::int, 50), 1) AS lim\n)\nSELECT *\nFROM (\n  SELECT\n    i.id,\n    i.fecha,\n    i.descripcion,\n    i.monto,\n    'ingresos'::text AS tipo,\n    'Ingreso'::text  AS categoria\n  FROM ingresos i, params p\n  WHERE (p.date_from IS NULL OR i.fecha >= p.date_from)\n    AND (p.date_to   IS NULL OR i.fecha <= p.date_to)\n\n  UNION ALL\n\n  SELECT\n    g.id,\n    g.fecha,\n    g.descripcion,\n    g.monto,\n    'gastos'::text AS tipo,\n    'Gasto'::text  AS categoria\n  FROM gastos g, params p\n  WHERE (p.date_from IS NULL OR g.fecha >= p.date_from)\n    AND (p.date_to   IS NULL OR g.fecha <= p.date_to)\n) t, params p\nORDER BY t.fecha DESC, t.id DESC\nLIMIT p.lim;",
        "additionalFields": {
          "queryParams": "={{[$json.query.from || \"\", $json.query.to || \"\", $json.query.limit || \"50\"]}}"
        }
      },
