    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH params AS (\n  SELECT\n    NULLIF($1,'')::date AS date_from,\n    NULLIF($2,'')::date AS date_to\n),\ning AS (\n  SELECT COALESCE(SUM(i.monto),0) AS total\n  FROM ingresos i, params p\n  WHERE (p.date_from IS NULL OR i.fecha >= p.date_from)\n    AND (p.date_to   IS NULL OR i.fecha <= p.date_to)\n),\ngas AS (\n  SELECT COALESCE(SUM(g.monto),0) AS total\n  FROM gastos g, params p\n  WHERE (p.date_from IS NULL OR g.fecha >= p.date_from)\n    AND (p.date_to   IS NULL OR g.fecha <= p.date_to)\n)\nSELECT\n  (SELECT total FROM ing) AS ingresos,\n  (SELECT total FROM gas) AS gastos,\n  (SELECT total FROM ing) - (SELECT total FROM gas) AS balance;",
        "additionalFields": {
          "queryParams": "={{[$json.query.from || \"\", $json.query.to || \"\"]}}"
        }
      },
