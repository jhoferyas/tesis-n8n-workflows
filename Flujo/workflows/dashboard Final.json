    {
      "parameters": {
        "html": "<!doctype html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\" />\n  <title>Login</title>\n\n  <style>\n    :root{\n      --bg:#2f4050;          /* fondo azul/gris */\n      --panel:#2f4050;\n      --line:rgba(255,255,255,.25);\n      --text:#eaf2ff;\n      --muted:rgba(255,255,255,.65);\n      --inputBg:rgba(0,0,0,.12);\n      --btn:#e5e7eb;\n      --btnText:#111827;\n      --shadow:0 18px 50px rgba(0,0,0,.35);\n    }\n\n    *{box-sizing:border-box;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;}\n    body{\n      margin:0;\n      min-height:100vh;\n      display:grid;\n      place-items:center;\n      background:var(--bg);\n      overflow:hidden;\n    }\n\n    /* “corte” diagonal de fondo como el de la imagen */\n    .bg-diagonal{\n      position:fixed;\n      inset:-30%;\n      background:rgba(255,255,255,.06);\n      transform:rotate(-18deg);\n      pointer-events:none;\n    }\n\n    .login-wrap{\n      width:min(420px, 92vw);\n      text-align:center;\n      position:relative;\n      z-index:1;\n    }\n\n    .avatar{\n      width:120px;height:120px;\n      margin:0 auto 12px;\n      border-radius:50%;\n      background:#2f6f7a; /* círculo verde/azul del avatar */\n      display:grid;\n      place-items:center;\n      box-shadow:var(--shadow);\n      overflow:hidden;\n    }\n\n    /* avatar simple en CSS (puedes reemplazar por imagen si quieres) */\n    .avatar svg{width:86px;height:86px; display:block;}\n\n    h1{\n      color:var(--text);\n      font-size:28px;\n      margin:6px 0 18px;\n      font-weight:800;\n      letter-spacing:.2px;\n    }\n\n    .form{\n      display:flex;\n      flex-direction:column;\n      gap:12px;\n      align-items:center;\n    }\n\n    .input{\n      width:100%;\n      max-width:360px;\n      padding:12px 14px;\n      border-radius:3px;\n      border:1px solid var(--line);\n      background:var(--inputBg);\n      color:var(--text);\n      outline:none;\n      font-size:14px;\n    }\n\n    .input::placeholder{ color:var(--muted); }\n\n    .btn{\n      align-self:flex-start;\n      margin-left:calc((100% - 360px)/2);\n      padding:10px 14px;\n      border-radius:2px;\n      border:1px solid rgba(0,0,0,.15);\n      background:var(--btn);\n      color:var(--btnText);\n      font-weight:700;\n      cursor:pointer;\n      transition:transform .05s ease, filter .15s ease;\n    }\n\n    .btn:active{ transform:translateY(1px); }\n    .btn:hover{ filter:brightness(.98); }\n\n    .hint{\n      margin-top:14px;\n      color:var(--muted);\n      font-size:12px;\n    }\n\n    /* para pantallas chicas: centrar botón */\n    @media (max-width: 420px){\n      .btn{\n        align-self:center;\n        margin-left:0;\n      }\n    }\n  </style>\n</head>\n\n<body>\n  <div class=\"bg-diagonal\"></div>\n\n  <div class=\"login-wrap\">\n    <div class=\"avatar\" aria-hidden=\"true\">\n      <!-- avatar sencillo -->\n      <svg viewBox=\"0 0 64 64\" fill=\"none\">\n        <circle cx=\"32\" cy=\"24\" r=\"12\" fill=\"#f2c7a6\"/>\n        <path d=\"M20 54c0-8 6-14 12-14s12 6 12 14\" fill=\"#111827\"/>\n        <path d=\"M22 24c1-10 9-14 16-14s15 4 16 14c-6-2-10-6-16-6s-10 4-16 6Z\" fill=\"#0b1220\"/>\n        <path d=\"M26 40h12l-2 14H28l-2-14Z\" fill=\"#1f2937\"/>\n        <path d=\"M32 40l4 6-4 6-4-6 4-6Z\" fill=\"#cbd5e1\"/>\n      </svg>\n    </div>\n\n    <h1>Bienvenido a MaluEventos</h1>\n\n    <form class=\"form\" id=\"loginForm\">\n      <input class=\"input\" id=\"user\" type=\"text\" placeholder=\"Email o nombre de usuario\" autocomplete=\"username\" required>\n      <input class=\"input\" id=\"pass\" type=\"password\" placeholder=\"Contraseña\" autocomplete=\"current-password\" required>\n\n      <button class=\"btn\" type=\"submit\">Iniciar Sesión</button>\n    </form>\n\n    <div class=\"hint\">Al presionar “Iniciar Sesión” se redirige al dashboard.</div>\n  </div>\n\n  <script>\n    const DASHBOARD_URL = \"http://localhost:5678/webhook/dashboard\";\n\n    document.getElementById(\"loginForm\").addEventListener(\"submit\", (e) => {\n      e.preventDefault();\n\n      const user = document.getElementById(\"user\").value.trim();\n      const pass = document.getElementById(\"pass\").value.trim();\n\n      // (Opcional) Validación mínima: que no vayan vacíos\n      if (!user || !pass) return;\n\n      // Redirección directa\n      window.location.href = DASHBOARD_URL;\n    });\n  </script>\n</body>\n</html>"
      },
