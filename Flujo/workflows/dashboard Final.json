    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH params AS (\n  SELECT\n    NULLIF('{{ $json.query.from || \"\" }}','')::date AS date_from,\n    NULLIF('{{ $json.query.to || \"\" }}','')::date AS date_to\n),\ning AS (\n  SELECT COALESCE(SUM(i.monto),0) AS total\n  FROM public.ingresos i, params p\n  WHERE (p.date_from IS NULL OR i.fecha >= p.date_from)\n    AND (p.date_to   IS NULL OR i.fecha <= p.date_to)\n),\ngas AS (\n  SELECT COALESCE(SUM(g.monto),0) AS total\n  FROM public.gastos g, params p\n  WHERE (p.date_from IS NULL OR g.fecha >= p.date_from)\n    AND (p.date_to   IS NULL OR g.fecha <= p.date_to)\n)\nSELECT\n  (SELECT total FROM ing) AS ingresos,\n  (SELECT total FROM gas) AS gastos,\n  (SELECT total FROM ing) - (SELECT total FROM gas) AS balance;\n",
        "options": {}
      },
