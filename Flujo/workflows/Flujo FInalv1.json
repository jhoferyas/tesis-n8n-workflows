    {
      "parameters": {
        "jsCode": "// Function node (n8n) - Parse Report Request\n// Entrada esperada: items[0].json.textoEntrada (string)\n// Resultado: json con { tipo, startDate, endDate, human, original }\n\nconst input = (items[0].json.textoEntrada || \"\").toString().trim().toLowerCase();\n\n// helpers\nconst monthNames = {\n  enero:0, febrero:1, marzo:2, abril:3, mayo:4, junio:5,\n  julio:6, agosto:7, septiembre:8, octubre:9, noviembre:10, diciembre:11\n};\n\nfunction pad(n){ return n < 10 ? '0' + n : '' + n; }\nfunction toISODate(d){ return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`; }\n\n// default year\nconst now = new Date();\nconst defaultYear = now.getFullYear();\n\n// iniciales\nlet tipo = null; // 'ingresos', 'egresos', 'ganancias'\nlet startDate = null;\nlet endDate = null;\nlet human = null;\n\n// detectar tipo (NUEVO: ganancias)\nif (/ingresos?|entradas|ingreso/.test(input)) tipo = 'ingresos';\nif (/egresos?|gastos?|salidas|egreso/.test(input)) tipo = 'egresos';\nif (/ganancias?|utilidad|beneficio|resultado/.test(input)) tipo = 'ganancias';\n\n// 1) detectar rangos explícitos\nlet explicitRange = input.match(/del\\s+(\\d{1,2})\\s+(?:al|-)\\s+(\\d{1,2})\\s+de\\s+([a-záéíóúñ]+)(?:\\s+de\\s+(\\d{4}))?/i);\nif(explicitRange){\n  const day1 = parseInt(explicitRange[1],10);\n  const day2 = parseInt(explicitRange[2],10);\n  const monthName = explicitRange[3].normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\n  const year = explicitRange[4] ? parseInt(explicitRange[4],10) : defaultYear;\n  const m = monthNames[monthName];\n  if(typeof m !== 'undefined'){\n    startDate = toISODate(new Date(year, m, day1));\n    endDate = toISODate(new Date(year, m, day2));\n    human = `Del ${day1} al ${day2} de ${monthName}${ explicitRange[4] ? ' de ' + year : '' }`;\n  }\n}\n\n// 2) detectar \"mes de <mes>\" o \"en <mes>\"\nif(!startDate){\n  let m = input.match(/\\b(?:mes\\s+de|en)\\s+([a-záéíóúñ]+)(?:\\s+de\\s+(\\d{4}))?/i);\n  if(m){\n    const monthNameRaw = m[1].normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\n    const year = m[2] ? parseInt(m[2],10) : defaultYear;\n    const monthIndex = monthNames[monthNameRaw];\n    if(typeof monthIndex !== 'undefined'){\n      const s = new Date(year, monthIndex, 1);\n      const last = new Date(year, monthIndex + 1, 0);\n      startDate = toISODate(s);\n      endDate = toISODate(last);\n      human = `Mes de ${monthNameRaw}${ m[2] ? ' de ' + year : '' }`;\n    }\n  }\n}\n\n// 3) primera semana\nif(!startDate){\n  let w = input.match(/primera\\s+semana(?:\\s+del\\s+mes(?:\\s+de\\s+([a-záéíóúñ]+)(?:\\s+de\\s+(\\d{4}))?)?)?/i);\n  if(w){\n    let monthIndex = now.getMonth();\n    let year = defaultYear;\n    if(w[1]){\n      const mname = w[1].normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\n      if(typeof monthNames[mname] !== 'undefined') monthIndex = monthNames[mname];\n      if(w[2]) year = parseInt(w[2],10);\n    }\n    const s = new Date(year, monthIndex, 1);\n    const e = new Date(year, monthIndex, 7);\n    startDate = toISODate(s);\n    endDate = toISODate(e);\n    human = `Primera semana de ${(w[1] ? w[1] : now.toLocaleString('es-ES',{month:'long'}))}`;\n  }\n}\n\n// 4) primeros X días\nif(!startDate){\n  let p = input.match(/primeros?\\s+(\\d{1,2})\\s+d[ií]as(?:\\s+del\\s+mes(?:\\s+de\\s+([a-záéíóúñ]+)(?:\\s+de\\s+(\\d{4}))?)?)?/i);\n  if(p){\n    const dias = parseInt(p[1],10);\n    let monthIndex = now.getMonth();\n    let year = defaultYear;\n    if(p[2]){\n      const mname = p[2].normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\n      if(typeof monthNames[mname] !== 'undefined') monthIndex = monthNames[mname];\n      if(p[3]) year = parseInt(p[3],10);\n    }\n    const s = new Date(year, monthIndex, 1);\n    const e = new Date(year, monthIndex, dias);\n    startDate = toISODate(s);\n    endDate = toISODate(e);\n    human = `Primeros ${dias} días de ${ p[2] ? p[2] : now.toLocaleString('es-ES',{month:'long'}) }`;\n  }\n}\n\n// 5) rangos absolutos dd/mm/aaaa\nif(!startDate){\n  let d = input.match(/desde\\s+(\\d{1,2}[\\/\\-]\\d{1,2}(?:[\\/\\-]\\d{2,4})?)\\s+(?:hasta|al)\\s+(\\d{1,2}[\\/\\-]\\d{1,2}(?:[\\/\\-]\\d{2,4})?)/i);\n  if(d){\n    function parseDateStr(ds){\n      const parts = ds.replace(/\\-/g,'/').split('/');\n      if(parts.length === 3){\n        let day = parseInt(parts[0],10);\n        let month = parseInt(parts[1],10)-1;\n        let year = parseInt(parts[2],10);\n        if(year < 100) year += 2000;\n        return toISODate(new Date(year, month, day));\n      }\n      return null;\n    }\n    const s = parseDateStr(d[1]);\n    const e = parseDateStr(d[2]);\n    if(s && e){ startDate = s; endDate = e; human = `Desde ${d[1]} hasta ${d[2]}`; }\n  }\n}\n\n// 6) este mes\nif(!startDate){\n  if(/\\b(este\\s+mes|mes\\s+actual|en\\s+este\\s+mes)\\b/.test(input)){\n    const s = new Date(defaultYear, now.getMonth(), 1);\n    const e = new Date(defaultYear, now.getMonth()+1, 0);\n    startDate = toISODate(s);\n    endDate = toISODate(e);\n    human = `Mes actual (${now.toLocaleString('es-ES',{month:'long'})})`;\n  }\n}\n\n// 7) fallback: hoy\nif(!startDate){\n  startDate = toISODate(now);\n  endDate = toISODate(now);\n  human = 'Hoy';\n}\n\n// --- Detectar tipo si no fue detectado ---\nif(!tipo){\n  if(/ingreso|ingresos|entrada/.test(input)) tipo = 'ingresos';\n  if(/egreso|egresos|gasto|gastos|salida/.test(input)) tipo = 'egresos';\n  if(/ganancias?|utilidad|beneficio|resultado/.test(input)) tipo = 'ganancias';\n}\n\n// devolver\nreturn [{ json: { original: input, tipo, startDate, endDate, human } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1504,
        384
      ],
      "id": "7dd8fdd5-e230-46a1-b51e-9d0a15283726",
      "name": "Extrae datos del mensaje"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT *\nFROM {{$json[\"tipo\"] == \"ingresos\" ? \"ingresos\" : \"gastos\"}}\nWHERE \"fecha\" BETWEEN '{{$json[\"startDate\"]}}' AND '{{$json[\"endDate\"]}}';",
        "options": {}
