        "query": "SELECT \n  'ingresos' AS tipo,\n  fecha,\n  descripcion,\n  monto\nFROM ingresos\nWHERE fecha BETWEEN '{{$json[\"startDate\"]}}' AND '{{$json[\"endDate\"]}}'\n\nUNION ALL\n\nSELECT \n  'gastos' AS tipo,\n  fecha,\n  descripcion,\n  monto\nFROM gastos\nWHERE fecha BETWEEN '{{$json[\"startDate\"]}}' AND '{{$json[\"endDate\"]}}';",
