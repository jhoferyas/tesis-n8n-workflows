    {
      "parameters": {
        "jsCode": "// Function node (n8n) - Parse Report Request\n\nconst input = (items[0].json.textoEntrada || \"\")\n  .toString()\n  .trim()\n  .toLowerCase();\n\n// helpers\nconst monthNames = {\n  enero:0, febrero:1, marzo:2, abril:3, mayo:4, junio:5,\n  julio:6, agosto:7, septiembre:8, octubre:9, noviembre:10, diciembre:11\n};\n\nfunction pad(n){ return n < 10 ? '0' + n : '' + n; }\nfunction toISODate(d){\n  return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;\n}\n\nconst now = new Date();\n\n// ===============================\n// 🧠 DETECCIÓN CORRECTA DEL AÑO\n// ===============================\nlet detectedYear = null;\n\n// 1️⃣ año explícito (2024, 2025, etc.)\nconst yearMatch = input.match(/\\b(20\\d{2})\\b/);\nif (yearMatch) {\n  detectedYear = parseInt(yearMatch[1], 10);\n}\n\n// 2️⃣ año pasado / anterior\nif (/año\\s+pasado|año\\s+anterior/.test(input)) {\n  detectedYear = now.getFullYear() - 1;\n}\n\n// 3️⃣ fallback\nconst defaultYear = detectedYear ?? now.getFullYear();\n\n// ===============================\n// VARIABLES\n// ===============================\nlet tipo = null;\nlet startDate = null;\nlet endDate = null;\nlet human = null;\n\n// ===============================\n// TIPO\n// ===============================\nif (/ingresos?|entradas/.test(input)) tipo = 'ingresos';\nif (/egresos?|gastos?|salidas/.test(input)) tipo = 'egresos';\nif (/ganancias?|utilidad|beneficio|resultado/.test(input)) tipo = 'ganancias';\n\n// ===============================\n// MES COMPLETO\n// ===============================\nif(!startDate){\n  let m = input.match(/\\b(?:mes\\s+de|en)\\s+([a-záéíóúñ]+)/i);\n  if(m){\n    const monthName = m[1]\n      .normalize('NFD')\n      .replace(/[\\u0300-\\u036f]/g, '');\n\n    const monthIndex = monthNames[monthName];\n\n    if(typeof monthIndex !== 'undefined'){\n      const s = new Date(defaultYear, monthIndex, 1);\n      const e = new Date(defaultYear, monthIndex + 1, 0);\n\n      startDate = toISODate(s);\n      endDate = toISODate(e);\n      human = `Mes de ${monthName} de ${defaultYear}`;\n    }\n  }\n}\n\n// ===============================\n// FALLBACK: HOY\n// ===============================\nif(!startDate){\n  startDate = toISODate(now);\n  endDate = toISODate(now);\n  human = 'Hoy';\n}\n\n// ===============================\n// SALIDA\n// ===============================\nreturn [{\n  json: {\n    original: input,\n    tipo,\n    startDate,\n    endDate,\n    human\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -560,
        608
      ],
      "id": "2286cfcd-4921-424f-9f54-ad2be9c2db0f",
      "name": "Extrae datos del mensaje"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT *\nFROM {{$json[\"tipo\"] == \"ingresos\" ? \"ingresos\" : \"gastos\"}}\nWHERE \"fecha\" BETWEEN '{{$json[\"startDate\"]}}' AND '{{$json[\"endDate\"]}}';",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -96,
        720
      ],
      "id": "0c90363a-383b-476d-9a3c-38efae74f8a8",
      "name": "Realiza consulta en DB",
      "credentials": {
        "postgres": {
          "id": "uBNdvmJCsYLPhdNw",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// 🔹 Datos que puedes cambiar o recibir de otro nodo\nconst empresa = \"MALUEVENTOS\";\nconst tipo = $('Extrae datos del mensaje').first().json.tipo; // o \"gastos\"\nconst periodo = $('Extrae datos del mensaje').first().json.human;\n\n// 🔹 Recibir los registros del nodo anterior (PostgreSQL)\nconst rows = items.map(item => item.json);\n\n// 🔹 Formatear fechas y calcular el total\nconst registros = rows.map(row => ({\n  fecha: new Date(row.fecha).toLocaleDateString(\"es-EC\"),\n  descripcion: row.descripcion,\n  monto: parseFloat(row.monto)\n}));\n\nconst total = registros.reduce((sum, r) => sum + r.monto, 0);\n\n// 🔹 Estructurar salida final\nreturn [\n  {\n    json: {\n      empresa,\n      tipo,\n      periodo,\n      registros,\n      total\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
