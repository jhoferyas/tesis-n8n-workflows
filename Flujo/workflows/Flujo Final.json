      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT *\nFROM {{$json[\"tipo\"] == \"ingresos\" ? \"ingresos\" : \"gastos\"}}\nWHERE \"fecha\" BETWEEN '{{$json[\"startDate\"]}}' AND '{{$json[\"endDate\"]}}';",
        "options": {}
      },
