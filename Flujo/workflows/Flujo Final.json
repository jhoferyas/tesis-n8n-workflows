    {
      "parameters": {
        "jsCode": "// Datos fijos\nconst empresa = \"MALUEVENTOS\";\nconst tipo = $('Extrae datos del mensaje').first().json.tipo; \nconst periodo = $('Extrae datos del mensaje').first().json.human;\n// Obtener filas de la consulta SQL (UNION ALL)\nconst rows = items.map(i => i.json);\n// Formateo estándar\nfunction formatRow(row){\n  return {\n    fecha: new Date(row.fecha).toLocaleDateString(\"es-EC\"),\n    descripcion: row.descripcion,\n    monto: parseFloat(row.monto)\n  };\n}\n// Separar según el tipo devuelto por SQL\nconst registrosIngresos = rows\n  .filter(r => r.tipo === \"ingresos\")\n  .map(formatRow);\n\nconst registrosGastos = rows\n  .filter(r => r.tipo === \"gastos\")\n  .map(formatRow);\n// Totales\nconst totalIngresos = registrosIngresos.reduce((s, r) => s + r.monto, 0);\nconst totalGastos = registrosGastos.reduce((s, r) => s + r.monto, 0);\n// Ganancias\nconst totalGanancias = totalIngresos - totalGastos;\n// Salida final\nreturn [\n  {\n    json: {\n      empresa,\n      tipo,\n      periodo,\n      registros_ingresos: registrosIngresos,\n      total_ingresos: totalIngresos,\n      registros_gastos: registrosGastos,\n      total_gastos: totalGastos,\n      total_ganancias: totalGanancias\n    }\n  }\n];"
      },
